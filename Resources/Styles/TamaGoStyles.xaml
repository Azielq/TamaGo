<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="TamaGo.Resources.Styles.TamaGoStyles">

    <!-- Colores principales -->
    <Color x:Key="PrimaryColor">#5865F2</Color>
    <Color x:Key="SecondaryColor">#FFA500</Color>
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="CardBackgroundColor">White</Color>
    <Color x:Key="TextPrimaryColor">#333333</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>
    <Color x:Key="TextMutedColor">#999999</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>

    <!-- Estilos de Label -->
    <Style x:Key="PageTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}"/>
    </Style>

    <Style x:Key="CaptionStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource TextMutedColor}"/>
    </Style>

    <!-- Estilos de Border -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundColor}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="10"/>
        </Setter>
    </Style>

    <Style x:Key="CategoryBadgeStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="15"/>
        </Setter>
    </Style>

    <!-- Estilos de Button -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HeightRequest" Value="44"/>
    </Style>

    <!-- Estilos de SearchBar -->
    <Style x:Key="SearchBarStyle" TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="#F0F0F0"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMutedColor}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

    <!-- Estilos de Grid para navegación inferior -->
    <Style x:Key="BottomNavStyle" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundColor}"/>
        <Setter Property="HeightRequest" Value="60"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>
    
    <!-- Estilos implícitos (se aplican automáticamente) -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundColor}"/>
    </Style>

    <Style TargetType="NavigationPage" ApplyToDerivedTypes="True">
        <Setter Property="BarBackgroundColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BarTextColor" Value="White"/>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="#F0F0F0"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMutedColor}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
    </Style>

</ResourceDictionary>