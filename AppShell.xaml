<?xml version="1.0" encoding="UTF-8"?>
<Shell
    x:Class="TamaGo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TamaGo.Views"
    Title="TamaGo">

    <!-- Página de inicio de sesión (NO visible en el menú) -->
    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        IsVisible="False" />

    <!-- Menú principal después de iniciar sesión -->
    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate views:MenuPage}"
        Route="MenuPage" />

    <!-- Destinos -->
    <ShellContent
        Title="Destinos"
        ContentTemplate="{DataTemplate views:DestinationsPage}"
        Route="DestinationsPage" />

    <!-- Reservas -->
    <ShellContent
        Title="Mis Reservas"
        ContentTemplate="{DataTemplate views:BookingsPage}"
        Route="BookingsPage" />

</Shell>