<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TamaGo.Views.DestinationsPage"
             Title="Destinos"
             BackgroundColor="#F5F5F5">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header con búsqueda y filtros -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" BackgroundColor="White" Spacing="10">
            <SearchBar Placeholder="Buscar destinos en Tamarindo"
                       BackgroundColor="#F0F0F0"/>
            
            <!-- Filtros de categoría -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="10">
                    <Border BackgroundColor="#5865F2" Padding="10,5" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Label Text="Todos" TextColor="White" FontSize="12"/>
                    </Border>
                    
                    <Border BackgroundColor="White" Padding="10,5" StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Label Text="🏖️ Playas" FontSize="12"/>
                    </Border>
                    
                    <Border BackgroundColor="White" Padding="10,5" StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Label Text="🏄 Surf" FontSize="12"/>
                    </Border>
                    
                    <Border BackgroundColor="White" Padding="10,5" StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Label Text="🐴 Tours" FontSize="12"/>
                    </Border>
                    
                    <Border BackgroundColor="White" Padding="10,5" StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Label Text="🌴 Naturaleza" FontSize="12"/>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>
        
        <!-- Lista de destinos -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <!-- Destinos destacados -->
                <Label Text="Destinos destacados" FontSize="20" FontAttributes="Bold"/>
                
                <!-- Tarjeta de destino 1 -->
                <Border BackgroundColor="White" Padding="0" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid RowDefinitions="180,Auto">
                        <!-- Imagen -->
                        <Border Grid.Row="0" 
                                BackgroundColor="#E0E0E0" 
                                HeightRequest="180"
                                Padding="0"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10,10,0,0"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Label Text="🏖️" FontSize="60" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                                <!-- Badge de categoría -->
                                <Border BackgroundColor="#5865F2" 
                                        Padding="8,4" 
                                        HorizontalOptions="Start" 
                                        VerticalOptions="Start"
                                        Margin="10"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="Playa" TextColor="White" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Información -->
                        <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="5">
                            <Label Text="Playa Tamarindo" FontAttributes="Bold" FontSize="18"/>
                            <Label Text="La playa principal con aguas cristalinas perfectas para surf y natación" 
                                   TextColor="#666666" 
                                   FontSize="14"/>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="⭐ 4.8" TextColor="#FFA500" FontSize="12"/>
                                <Label Text="•" TextColor="#999999"/>
                                <Label Text="📍 Centro" TextColor="#666666" FontSize="12"/>
                                <Label Text="•" TextColor="#999999"/>
                                <Label Text="🏄 Surf disponible" TextColor="#5865F2" FontSize="12"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                
                <!-- Tarjeta de destino 2 -->
                <Border BackgroundColor="White" Padding="0" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid RowDefinitions="180,Auto">
                        <!-- Imagen -->
                        <Border Grid.Row="0" 
                                BackgroundColor="#E0E0E0" 
                                HeightRequest="180"
                                Padding="0"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10,10,0,0"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Label Text="🌊" FontSize="60" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                                <!-- Badge de categoría -->
                                <Border BackgroundColor="#5865F2" 
                                        Padding="8,4" 
                                        HorizontalOptions="Start" 
                                        VerticalOptions="Start"
                                        Margin="10"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="Playa" TextColor="White" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Información -->
                        <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="5">
                            <Label Text="Playa Langosta" FontAttributes="Bold" FontSize="18"/>
                            <Label Text="Playa tranquila ideal para familias, con piscinas naturales durante marea baja" 
                                   TextColor="#666666" 
                                   FontSize="14"/>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="⭐ 4.9" TextColor="#FFA500" FontSize="12"/>
                                <Label Text="•" TextColor="#999999"/>
                                <Label Text="📍 2km Sur" TextColor="#666666" FontSize="12"/>
                                <Label Text="•" TextColor="#999999"/>
                                <Label Text="👨‍👩‍👧‍👦 Familiar" TextColor="#5865F2" FontSize="12"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                
                <!-- Más destinos -->
                <Label Text="Otros lugares de interés" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0"/>
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <!-- Mini tarjeta 1 -->
                    <Border Grid.Column="0" BackgroundColor="White" Padding="15" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="🏔️" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="Cerro Vista Mar" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                            <Label Text="Mirador" TextColor="#666666" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="⭐ 4.5" TextColor="#FFA500" FontSize="12" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Mini tarjeta 2 -->
                    <Border Grid.Column="1" BackgroundColor="White" Padding="15" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="🌴" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="Parque Nacional" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                            <Label Text="Naturaleza" TextColor="#666666" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="⭐ 4.7" TextColor="#FFA500" FontSize="12" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Bottom Navigation -->
        <Grid Grid.Row="2" 
              BackgroundColor="White" 
              ColumnDefinitions="*,*,*,*,*" 
              HeightRequest="60"
              Padding="10,5">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="🏠" FontSize="24" TextColor="#999999"/>
                <Label Text="Inicio" FontSize="10" TextColor="#999999"/>
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="❤️" FontSize="24" TextColor="#999999"/>
                <Label Text="Favoritos" FontSize="10" TextColor="#999999"/>
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="🗺️" FontSize="24" TextColor="#5865F2"/>
                <Label Text="Mapa" FontSize="10" TextColor="#5865F2"/>
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="📋" FontSize="24" TextColor="#999999"/>
                <Label Text="Planes" FontSize="10" TextColor="#999999"/>
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="4" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="👤" FontSize="24" TextColor="#999999"/>
                <Label Text="Perfil" FontSize="10" TextColor="#999999"/>
            </VerticalStackLayout>
        </Grid>
        
    </Grid>
    </ContentPage.Content>
</ContentPage>