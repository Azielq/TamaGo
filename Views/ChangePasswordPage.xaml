<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TamaGo.Views.ChangePasswordPage"
             Title="Cambiar Contraseña"
             BackgroundColor="#F5F5F5">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" BackgroundColor="White">
            <Label Text="Cambiar Contraseña" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalOptions="Center"/>
            <Label Text="Ingresa tu contraseña actual y la nueva" 
                   FontSize="14" 
                   TextColor="#666666"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
        
        <!-- Contenido principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <!-- Formulario de cambio de contraseña -->
                <Border BackgroundColor="White" Padding="25" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="20">
                        
                        <Label Text="🔒 Cambio de Contraseña" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333333"
                               HorizontalOptions="Center"/>
                        
                        <!-- Contraseña actual -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Contraseña Actual *" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="#333333"/>
                            <Border BackgroundColor="#F8F9FA" 
                                    StrokeThickness="1" 
                                    Stroke="#E0E0E0"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Entry x:Name="CurrentPasswordEntry" 
                                       Placeholder="Ingresa tu contraseña actual"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#333333"
                                       PlaceholderColor="#999999"
                                       HeightRequest="50"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Nueva contraseña -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nueva Contraseña *" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="#333333"/>
                            <Border BackgroundColor="#F8F9FA" 
                                    StrokeThickness="1" 
                                    Stroke="#E0E0E0"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Entry x:Name="NewPasswordEntry" 
                                       Placeholder="Ingresa tu nueva contraseña"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#333333"
                                       PlaceholderColor="#999999"
                                       HeightRequest="50"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Confirmar nueva contraseña -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Confirmar Nueva Contraseña *" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="#333333"/>
                            <Border BackgroundColor="#F8F9FA" 
                                    StrokeThickness="1" 
                                    Stroke="#E0E0E0"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Entry x:Name="ConfirmPasswordEntry" 
                                       Placeholder="Confirma tu nueva contraseña"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#333333"
                                       PlaceholderColor="#999999"
                                       HeightRequest="50"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Botones -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                            <Button Grid.Column="0"
                                    Text="Cancelar" 
                                    BackgroundColor="#E0E0E0" 
                                    TextColor="#666666" 
                                    CornerRadius="25"
                                    HeightRequest="50"
                                    Clicked="OnCancelClicked"/>
                            
                            <Button Grid.Column="1"
                                    x:Name="ChangePasswordButton"
                                    Text="Cambiar Contraseña" 
                                    BackgroundColor="#5865F2" 
                                    TextColor="White" 
                                    CornerRadius="25"
                                    HeightRequest="50"
                                    Clicked="OnChangePasswordClicked"/>
                        </Grid>
                        
                    </VerticalStackLayout>
                </Border>
                
                <!-- Información de seguridad -->
                <Border BackgroundColor="#FFF3E0" Padding="20" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="💡 Consejos de Seguridad" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#E65100"/>
                        
                        <Label Text="• Usa al menos 8 caracteres" 
                               FontSize="12" 
                               TextColor="#666666"/>
                        <Label Text="• Incluye mayúsculas y minúsculas" 
                               FontSize="12" 
                               TextColor="#666666"/>
                        <Label Text="• Agrega números y símbolos" 
                               FontSize="12" 
                               TextColor="#666666"/>
                        <Label Text="• No uses información personal" 
                               FontSize="12" 
                               TextColor="#666666"/>
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>
        
    </Grid>
    </ContentPage.Content>
</ContentPage>