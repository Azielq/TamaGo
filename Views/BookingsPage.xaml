<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TamaGo.Views.BookingsPage"
             Title="Mis Reservas"
             BackgroundColor="#F5F5F5">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" BackgroundColor="White">
            <Label Text="Mis Reservas" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="Gestiona tus tours y actividades" 
                   FontSize="14" 
                   TextColor="#666666"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
        
        <!-- Contenido principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <!-- Tabs de estado -->
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border x:Name="ActiveTab" 
                            BackgroundColor="#5865F2" 
                            Padding="15,8" 
                            StrokeThickness="0"
                            BindingContext="active">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabSelected"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding ActiveCount, StringFormat='Activas ({0})'}" 
                               TextColor="White" 
                               FontSize="14"/>
                    </Border>
                    
                    <Border x:Name="PastTab"
                            BackgroundColor="White" 
                            Padding="15,8" 
                            StrokeThickness="1" 
                            Stroke="#E0E0E0"
                            BindingContext="past">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabSelected"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding PastCount, StringFormat='Pasadas ({0})'}" 
                               TextColor="#666666" 
                               FontSize="14"/>
                    </Border>
                    
                    <Border x:Name="CancelledTab"
                            BackgroundColor="White" 
                            Padding="15,8" 
                            StrokeThickness="1" 
                            Stroke="#E0E0E0"
                            BindingContext="cancelled">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabSelected"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding CancelledCount, StringFormat='Canceladas ({0})'}" 
                               TextColor="#666666" 
                               FontSize="14"/>
                    </Border>
                </HorizontalStackLayout>
                
                <!-- Estado vacío con ilustración -->
                <Border BackgroundColor="White" 
                        Padding="30" 
                        StrokeThickness="0" 
                        Margin="0,40,0,0"
                        IsVisible="{Binding NoBookings}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="20">
                        <Label Text="🎒" FontSize="80" HorizontalOptions="Center"/>
                        <Label Text="No tienes reservas activas" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#333333"
                               HorizontalOptions="Center"/>
                        <Label Text="¡Explora nuestros increíbles tours y reserva tu próxima aventura!" 
                               FontSize="14" 
                               TextColor="#666666"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Explorar Tours"
                                BackgroundColor="#5865F2"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="44"
                                WidthRequest="150"
                                HorizontalOptions="Center"
                                Clicked="OnExploreToursClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Lista de reservas -->
                <CollectionView ItemsSource="{Binding CurrentBookings}"
                                IsVisible="{Binding HasBookings}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" 
                                    Padding="15" 
                                    StrokeThickness="0"
                                    Margin="0,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="15">
                                    <Border Grid.Column="0" 
                                            BackgroundColor="#E0E0E0" 
                                            HeightRequest="80"
                                            Padding="0"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Tour.Destination.CategoryEmoji}" 
                                               FontSize="30" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"/>
                                    </Border>
                                    
                                    <VerticalStackLayout Grid.Column="1" 
                                                         VerticalOptions="Center" 
                                                         Spacing="5">
                                        <Label Text="{Binding Tour.Title}" 
                                               FontAttributes="Bold" 
                                               FontSize="16" 
                                               TextColor="#333333"/>
                                        <Label Text="{Binding FormattedTourDate}" 
                                               TextColor="#666666" 
                                               FontSize="12"/>
                                        <Label Text="{Binding PeopleText}" 
                                               TextColor="#666666" 
                                               FontSize="12"/>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding FormattedPrice}" 
                                                   TextColor="#333333" 
                                                   FontSize="12"
                                                   FontAttributes="Bold"/>
                                            <Border BackgroundColor="{Binding StatusColor}" 
                                                    Padding="8,2" 
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding StatusText}" 
                                                       TextColor="White" 
                                                       FontSize="10"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                        <Button Text="Cancelar"
                                                BackgroundColor="#FF4444"
                                                TextColor="White"
                                                FontSize="10"
                                                Padding="8,4"
                                                CornerRadius="5"
                                                IsVisible="{Binding CanCancel}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelBookingCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <!-- Ejemplo de reserva (comentado para cuando haya datos) -->
                <!--
                <Border BackgroundColor="White" Padding="15" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="15">
                        <Border Grid.Column="0" 
                                BackgroundColor="#E0E0E0" 
                                HeightRequest="100"
                                Padding="0"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="🏄" FontSize="40" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                            <Label Text="Clase de Surf" FontAttributes="Bold" FontSize="16"/>
                            <Label Text="📅 15 Dic 2024 • 9:00 AM" TextColor="#666666" FontSize="12"/>
                            <Label Text="👥 2 personas • $60 total" TextColor="#666666" FontSize="12"/>
                            <Border BackgroundColor="#E8F5E9" Padding="5,2" HorizontalOptions="Start" StrokeThickness="0">
