                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="✓ Confirmada" TextColor="#4CAF50" FontSize="11"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                            <Label Text=">" FontSize="20" TextColor="#999999"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                -->
                
                <!-- Tips informativos -->
                <Label Text="Información útil" FontSize="18" FontAttributes="Bold" Margin="0,20,0,0"/>
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Border Grid.Column="0" BackgroundColor="#FFF3E0" Padding="15" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="📱" FontSize="30" HorizontalOptions="Center"/>
                            <Label Text="Confirmación" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="Recibirás un email con los detalles" 
                                   FontSize="11" 
                                   TextColor="#666666" 
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    
                    <Border Grid.Column="1" BackgroundColor="#E3F2FD" Padding="15" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="⏰" FontSize="30" HorizontalOptions="Center"/>
                            <Label Text="Puntualidad" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="Llega 15 min antes de tu tour" 
                                   FontSize="11" 
                                   TextColor="#666666" 
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Bottom Navigation -->
        <Grid Grid.Row="2" 
              BackgroundColor="White" 
              ColumnDefinitions="*,*,*,*" 
              HeightRequest="70"
              Padding="5">
            
            <!-- Tours -->
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnToursTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="🚌" FontSize="24" TextColor="#999999"/>
                <Label Text="Tours" FontSize="10" TextColor="#999999"/>
            </VerticalStackLayout>
            
            <!-- Destinos -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDestinationsTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="🌴" FontSize="24" TextColor="#999999"/>
                <Label Text="Destinos" FontSize="10" TextColor="#999999"/>
            </VerticalStackLayout>
            
            <!-- Inicio -->
            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="🏠" FontSize="24" TextColor="#999999"/>
                <Label Text="Inicio" FontSize="10" TextColor="#999999"/>
            </VerticalStackLayout>
            
            <!-- Cuenta -->
            <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAccountTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="👤" FontSize="24" TextColor="#999999"/>
                <Label Text="Cuenta" FontSize="10" TextColor="#999999"/>
            </VerticalStackLayout>
        </Grid>
        
    </Grid>
    </ContentPage.Content>
</ContentPage>