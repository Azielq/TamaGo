<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TamaGo"
             x:Class="TamaGo.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/TamaGoStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="Primary">#5865F2</Color>
            <Color x:Key="Secondary">#FF6B35</Color>
            <Color x:Key="Background">#F5F5F5</Color>
            <Color x:Key="TextPrimary">#000000</Color>
            <Color x:Key="TextSecondary">#666666</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
