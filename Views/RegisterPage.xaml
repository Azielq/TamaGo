<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TamaGo.Views.RegisterPage"
             Title="Crear una cuenta"
             BackgroundColor="#F5F5F5">
    <ContentPage.Content>
        <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="30">
                
                <Label Text="Crea una cuenta"
                       FontSize="28"
                       TextColor="#666666"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,20,0,10"/>
                
                
                
                <BoxView Color="#E0E0E0" HeightRequest="1" Margin="0,10"/>
                

                <Label Text="Ingresa tu nombre:"
                       FontSize="14"
                       TextColor="#666666"/>
                <Entry x:Name="FirstNameEntry"
                       TextColor="#666666"
                       BackgroundColor="White"/>

                <Label Text="Ingresa tu apellido:"
                       FontSize="14"
                       TextColor="#666666"/>
                <Entry x:Name="LastNameEntry"
                       TextColor="#666666"
                       BackgroundColor="White"/>
                
                <Label Text="Selecciona tu país de origen:"
                       FontSize="14"
                       TextColor="#666666"/>
                <Picker x:Name="CountryPicker"
                        TextColor="#666666"
                        BackgroundColor="White">
                    <Picker.Items>
                        <x:String>Costa Rica</x:String>
                        <x:String>Nicaragua</x:String>
                        <x:String>Panamá</x:String>
                        <x:String>Estados Unidos</x:String>
                        <x:String>Otro</x:String>
                    </Picker.Items>
                </Picker>
                
                <Label Text="Ingresa tu número telefónico:"
                       FontSize="14"
                       TextColor="#666666"/>
                <Entry x:Name="PhoneEntry"
                       Placeholder="+506 8888 1234"
                       TextColor="#666666"
                       BackgroundColor="White"
                       Keyboard="Telephone"/>
                
                <Label Text="Ingresa tu fecha de nacimiento:"
                       FontSize="14"
                       TextColor="#666666"/>
                <DatePicker x:Name="BirthDatePicker"
                            TextColor="#666666"
                            BackgroundColor="White"/>
                
                <Label Text="Ingresa tu nombre de usuario:"
                       FontSize="14"
                       TextColor="#666666"/>
                <Entry x:Name="UsernameEntry"
                       TextColor="#666666"
                       Placeholder="Ej: juan_pura_vida"
                       BackgroundColor="White"/>
                
                <Label Text="Ingresa tu contraseña:"
                       FontSize="14"
                       TextColor="#666666"/>
                <Entry x:Name="PasswordEntry"
                       IsPassword="True"
                       TextColor="#666666"
                       BackgroundColor="White"/>
                
                <Label Text="Repite tu contraseña:"
                       FontSize="14"
                       TextColor="#666666"/>
                <Entry x:Name="ConfirmPasswordEntry"
                       IsPassword="True"
                       TextColor="#666666"
                       BackgroundColor="White"/>
                
                <Button x:Name="RegisterButton"
                        Text="Continuar"
                        BackgroundColor="#5865F2"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        Margin="0,20,0,0"
                        Clicked="OnRegisterClicked"/>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              BackgroundColor="#80000000" 
              IsVisible="False">
            <Border BackgroundColor="White" 
                    WidthRequest="200" 
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <ActivityIndicator IsRunning="True" Color="#5865F2"/>
                    <Label Text="Registrando usuario..." TextColor="#666666"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
    </ContentPage.Content>
</ContentPage>