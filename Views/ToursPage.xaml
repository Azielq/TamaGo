<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TamaGo.Views.ToursPage"
             Title="Tours Disponibles"
             BackgroundColor="#F5F5F5">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" BackgroundColor="White">
            <Label Text="Tours Disponibles" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalOptions="Center"/>
            <Label Text="Descubre nuestras mejores experiencias" 
                   FontSize="14" 
                   TextColor="#666666"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
        
        <!-- Loading Indicator -->
        <ActivityIndicator x:Name="LoadingIndicator" 
                           Grid.Row="1"
                           IsVisible="False" 
                           IsRunning="False" 
                           Color="#5865F2"
                           VerticalOptions="Center"/>
        
        <!-- Contenido principal -->
        <ScrollView Grid.Row="1" x:Name="MainContent">
            <VerticalStackLayout Spacing="15" Padding="20">
                
                <!-- Mensaje cuando no hay tours -->
                <Border x:Name="NoToursMessage" 
                        BackgroundColor="White" 
                        Padding="30" 
                        StrokeThickness="0"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                        <Label Text="🎯" FontSize="50" HorizontalOptions="Center"/>
                        <Label Text="No hay tours disponibles" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333333" 
                               HorizontalOptions="Center"/>
                        <Label Text="Próximamente tendremos nuevas experiencias para ti" 
                               FontSize="14" 
                               TextColor="#666666" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Lista de tours -->
                <CollectionView x:Name="ToursCollectionView" 
                                ItemsSource="{Binding Tours}"
                                IsVisible="True">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" 
                                    Padding="15" 
                                    Margin="0,5" 
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTourTapped" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    
                                    <!-- Título del tour -->
                                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Title}" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="#333333"/>
                                    
                                    <!-- Descripción -->
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Description}" 
                                           FontSize="14" 
                                           TextColor="#666666" 
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           Margin="0,5,0,0"/>
                                    
                                    <!-- Duración -->
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="{Binding Duration, StringFormat='⏱️ {0}'}" 
                                           FontSize="12" 
                                           TextColor="#5865F2"
                                           Margin="0,10,0,0"/>
                                    
                                    <!-- Precio -->
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="{Binding Price, StringFormat='${0:N0}'}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="#2E7D32"
                                           HorizontalOptions="End"
                                           Margin="0,10,0,0"/>
                                    
                                    <!-- Disponibilidad -->
                                    <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="🟢 Disponible"
                                           TextColor="#2E7D32"
                                           FontSize="12" 
                                           Margin="0,5,0,0">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Text" Value="🔴 No disponible"/>
                                                <Setter Property="TextColor" Value="#D32F2F"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
            </VerticalStackLayout>
        </ScrollView>
        
    </Grid>
    </ContentPage.Content>
</ContentPage>